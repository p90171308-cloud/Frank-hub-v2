end

-- Teleport
local function teleportToPlayer(targetName)
    pcall(function()
        local targetPlayer = nil
        targetName = targetName:lower()
        for _, player in ipairs(Players:GetPlayers()) do
            if player.Name:lower():sub(1, #targetName) == targetName or player.DisplayName:lower():sub(1, #targetName) == targetName then
                targetPlayer = player
                break
            end
        end

        if targetPlayer and targetPlayer.Character and targetPlayer.Character:FindFirstChild("HumanoidRootPart") then
            if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                LocalPlayer.Character.HumanoidRootPart.CFrame = targetPlayer.Character.HumanoidRootPart.CFrame + Vector3.new(0, 3, 0)
            end
        end
    end)
end

-- Poses System
local function stopAllPoses()
    if activePoseConnection then
        activePoseConnection:Disconnect()
        activePoseConnection = nil
    end
end

local function playCustomPose(poseType)
    stopAllPoses()
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local rootPart = char.HumanoidRootPart

    activePoseConnection = RunService.RenderStepped:Connect(function()
        pcall(function()
            if not char or not rootPart then return end
            if poseType == "Aura" then
                rootPart.CFrame = rootPart.CFrame * CFrame.Angles(0, 0, math.rad(3))
            elseif poseType == "Chill" then
                rootPart.CFrame = rootPart.CFrame * CFrame.Angles(math.rad(20), 0, 0)
            elseif poseType == "Sigma" then
                rootPart.CFrame = rootPart.CFrame * CFrame.Angles(0, 0, math.sin(tick() * 8) * 0.04)
            elseif poseType == "Cross" then
                rootPart.CFrame = rootPart.CFrame * CFrame.Angles(math.rad(5), math.rad(10), 0)
            elseif poseType == "Look" then
                rootPart.CFrame = rootPart.CFrame * CFrame.Angles(0, math.sin(tick() * 3) * 0.2, 0)
            elseif poseType == "Stretch" then
                rootPart.CFrame = rootPart.CFrame + Vector3.new(0, math.sin(tick() * 5) * 0.1, 0)
            elseif poseType == "Confident" then
                rootPart.CFrame = rootPart.CFrame * CFrame.Angles(math.rad(-5), 0, 0)
            elseif poseType == "Aim" then
                rootPart.CFrame = rootPart.CFrame * CFrame.Angles(0, math.rad(15), 0)
            elseif poseType == "Wave" then
                rootPart.CFrame = rootPart.CFrame * CFrame.Angles(math.sin(tick() * 6) * 0.05, 0, 0)
            end
        end)
    end)
end

-- Camera Mode
local function setCameraPerspective(mode)
    currentPerspective = mode
    local camera = Workspace.CurrentCamera
    if not camera then return end

    if cameraConnection then
        cameraConnection:Disconnect()
        cameraConnection = nil
    end

    pcall(function()
        if mode == "1st" then
            LocalPlayer.CameraMinZoomDistance = 0.5
            LocalPlayer.CameraMaxZoomDistance = 0.5
            camera.CameraType = Enum.CameraType.Custom
        elseif mode == "2nd" then
            LocalPlayer.CameraMinZoomDistance = 6
            LocalPlayer.CameraMaxZoomDistance = 12
            camera.CameraType = Enum.CameraType.Scriptable

            cameraConnection = RunService.RenderStepped:Connect(function()
                if currentPerspective == "2nd" and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Head") then
                    local head = LocalPlayer.Character.Head
                    camera.CFrame = CFrame.new(head.Position + (head.CFrame.LookVector * 7) + Vector3.new(0, 1.5, 0), head.Position)
                end
            end)
        elseif mode == "3rd" then
            LocalPlayer.CameraMinZoomDistance = 12
            LocalPlayer.CameraMaxZoomDistance = 30
            camera.CameraType = Enum.CameraType.Custom
        elseif mode == "Normal" then
            LocalPlayer.CameraMinZoomDistance = 0.5
            LocalPlayer.CameraMaxZoomDistance = 128
            camera.CameraType = Enum.CameraType.Custom
        end
    end)
end

-- ESP
local function toggleESP(state)
    espEnabled = state
    if not espEnabled then
        for _, hl in pairs(espHighlights) do if hl then hl:Destroy() end end
        espHighlights = {}
    else
        RunService.RenderStepped:Connect(function()
            pcall(function()
                if not espEnabled then return end
                for _, player in ipairs(Players:GetPlayers()) do
                    if player ~= LocalPlayer and player.Character then
                        if not espHighlights[player] then
                            local highlight = Instance.new("Highlight")
                            highlight.FillColor = Color3.fromRGB(0, 170, 255)
                            highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                            highlight.Parent = player.Character
                            espHighlights[player] = highlight
                        end
                    end
                end
            end)
        end)
    end
end

-- 📌 3. Chat Commands Listener
LocalPlayer.Chatted:Connect(function(message)
    pcall(function()
        if message:sub(1, 1) ~= ";" and message:sub(1, 1) ~= "/" then return end
        local cleanMsg = message:sub(2)
        local args = {}
        for word in cleanMsg:gmatch("%S+") do table.insert(args, word) end
        local cmd = args[1] and args[1]:lower() or ""
        local val = args[2]

        if cmd == "speed" and tonumber(val) then
            currentSpeed = tonumber(val)
            isSpeedEnabled = true
            if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
                LocalPlayer.Character.Humanoid.WalkSpeed = tonumber(val)
            end
        elseif cmd == "jump" and tonumber(val) then
            currentJump = tonumber(val)
            isJumpEnabled = true
            if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
                LocalPlayer.Character.Humanoid.UseJumpPower = true
                LocalPlayer.Character.Humanoid.JumpPower = tonumber(val)
            end
        elseif cmd == "tp" and val then
            teleportToPlayer(val)
        elseif cmd == "noclip" then toggleNoclip(true)
        elseif cmd == "clip" then toggleNoclip(false)
        elseif cmd == "infjump" then infJumpEnabled = true
        elseif cmd == "god" then godModeEnabled = true
        elseif cmd == "fly" then toggleFly(true)
        elseif cmd == "unfly" then toggleFly(false)
        elseif cmd == "fullbright" then toggleFullbright(true)
        elseif cmd == "spin" then toggleSpinbot(true)
        elseif cmd == "gravity" then setLowGravity(true)
        elseif cmd == "rainbow" then toggleRainbow(true)
        elseif cmd == "invis" then toggleInvisible(true)
        elseif cmd == "reset" then
            isSpeedEnabled = false
            isJumpEnabled = false
            infJumpEnabled = false
            godModeEnabled = false
            toggleFly(false)
            toggleSpinbot(false)
            setLowGravity(false)
            toggleRainbow(false)
            toggleInvisible(false)
            stopAllPoses()
            toggleNoclip(false)
            if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
                LocalPlayer.Character.Humanoid.WalkSpeed = 16
                LocalPlayer.Character.Humanoid.JumpPower = 50
            end
        end
    end)
end)

